if [ "${COURSE}" == "Intro_to_PopGen" ]
then
    echo "-----> Chosen course: Intro to population Genetics"

    if [ ! -d "Course_Env" ] 
    then
        echo "----------> downloading packages"
        mkdir -p ${COURSE_DIR}/Course_Env
        fix-permissions ${COURSE_DIR}/Course_Env
        wget -t 10 -O ${COURSE_DIR}/Course_Env.tar.gz https://zenodo.org/record/7660785/files/Course_Env.unpacked.tar.gz?download=1;
        echo "----------> extracting packages"
        tar -zxf ${COURSE_DIR}/Course_Env.tar.gz -C ${COURSE_DIR}/Course_Env
        rm -f ${COURSE_DIR}/Course_Env.tar.gz
    else
        ln -sf Course_Env ${COURSE_DIR}/Course_Env
    fi

    if [ ! -d "Data" ] 
    then 
        echo "----------> downloading data"
        mkdir -p ${COURSE_DIR}/Data
        fix-permissions ${COURSE_DIR}/Data
        wget https://zenodo.org/record/7660785/files/Data.tar.gz?download=1 -O ${COURSE_DIR}/Data.tar.gz
        echo "----------> extracting data"
        tar -zxf ${COURSE_DIR}/Data.tar.gz -C ${COURSE_DIR}/Data
        rm -f ${COURSE_DIR}/Data.tar.gz 
    else
        ln -sf Data ${COURSE_DIR}/Data
    fi

    echo "----------> Installing course kernels on jupyterlab"
    ${COURSE_DIR}/Course_Env/bin/python -m ipykernel install --user --name="args_dashboard" --display-name "args dashboard"
    ${COURSE_DIR}/Course_Env/bin/R -e "IRkernel::installspec(user=TRUE, name = 'popgen_course', displayname = 'popgen course')"
    ${COURSE_DIR}/Course_Env/bin/python -m bash_kernel.install
    cp ${COURSE_DIR}/Course_Env/lib/libcrypto.so.3 ${COURSE_DIR}/Course_Env/lib/libcrypto.so.1.0.0

    git clone -b ucloud https://github.com/kaspermunch/PopulationGenomicsCourse.git /home/${NB_USER}/course
    mv /home/${NB_USER}/course/Exercises ./

    # kernel configurations with updated $PATH included
    cp /home/${NB_USER}/course/uCloud/Configurations/kernelBash.json ~/.local/share/jupyter/kernels/bash/kernel.json

    printf  "\n==================  "
    printf  "\n Start JupyterLab  \n"
    printf  "==================  \n\n"
    #add course name as variable to be used
    bash -c "jupyter lab --NotebookApp.token='' "
    
fi


