#!/bin/bash

while getopts c: option
do
    case "${option}"
    in
        c) COURSE=${OPTARG};;
        \?) ## Invalid option
            printf "Error: invalid option.\n\n"
            exit;;
    esac
done

COURSE_DIR=/work/Material/
mkdir -p ${COURSE_DIR}
fix-permissions ${COURSE_DIR}
chown -R "${NB_USER}":"${NB_GID}" ${COURSE_DIR}
chmod g+rwx ${COURSE_DIR}

printf  "\n==================  "
printf  "\n Selecting Course  \n"
printf  "==================  \n\n"

if [ "${COURSE}" == "Intro_to_NGS" ]
then
    echo "-----> Chosen course: Introduction to NGS data"

    if [ ! -d "Course_Env" ] 
    then
        echo "----------> downloading packages"
        mkdir -p ${COURSE_DIR}/Course_Env
        fix-permissions ${COURSE_DIR}/Course_Env
        wget -t 10 -O ${COURSE_DIR}/Course_Env.tar.gz https://zenodo.org/record/7670370/files/Course_Env.unpacked.tar.gz?download=1;
        echo "----------> extracting packages"
        tar -zxf ${COURSE_DIR}/Course_Env.tar.gz -C ${COURSE_DIR}/Course_Env
        rm -f ${COURSE_DIR}/Course_Env.tar.gz
    else
        ln -sf Course_Env ${COURSE_DIR}/Course_Env
    fi

    if [ ! -d "Data" ] 
    then 
        echo "----------> downloading data"
        mkdir -p ${COURSE_DIR}/Data
        fix-permissions ${COURSE_DIR}/Data
        wget -t 10 https://zenodo.org/record/7670370/files/Data.tar.gz?download=1 -O ${COURSE_DIR}/Data.tar.gz
        echo "----------> extracting data"
        tar -zxf ${COURSE_DIR}/Data.tar.gz -C ${COURSE_DIR}/Data
        rm -f ${COURSE_DIR}/Data.tar.gz ${COURSE_DIR}/Data.tar.gz 
    else
        ln -sf Data ${COURSE_DIR}/Data
    fi

    echo "----------> Installing course kernels on jupyterlab"
    ${COURSE_DIR}/Course_Env/bin/python -m ipykernel install --user --name="ngs_python" --display-name "NGS (Python)"
    ${COURSE_DIR}/Course_Env/bin/R -e "IRkernel::installspec(user=TRUE, name = 'ngs_r', displayname = 'NGS (R)')"
    
    git clone --depth 1 -b v2023.03.01 https://github.com/hds-sandbox/NGS_summer_course_Aarhus.git /home/${NB_USER}/course
    # kernel configurations with updated $PATH included
    cp /home/${NB_USER}/course/Environments/kernel_py_docker.json ~/.local/share/jupyter/kernels/ngs_python/kernel.json && \
    cp /home/${NB_USER}/course/Environments/kernel_R_docker.json ~/.local/share/jupyter/kernels/ngs_r/kernel.json

    if [ ! -d "Notebooks" ] 
    then 
        mv /home/${NB_USER}/course/Notebooks ./
    else
        ln -sf Notebooks ${COURSE_DIR}/Notebooks
    fi
    

    printf  "\n==================  "
    printf  "\n Start JupyterLab  \n"
    printf  "==================  \n\n"
    bash -c "jupyter lab --NotebookApp.token='' "

fi

if [ "${COURSE}" == "Intro_to_PopGen" ]
then
    echo "-----> Chosen course: Intro to population Genetics"

    if [ ! -d "Course_Env" ] 
    then
        echo "----------> downloading packages"
        mkdir -p ${COURSE_DIR}/Course_Env
        fix-permissions ${COURSE_DIR}/Course_Env
        wget -t 10 -O ${COURSE_DIR}/Course_Env.tar.gz https://zenodo.org/record/7670839/files/Course_Env.unpacked.tar.gz?download=1;
        echo "----------> extracting packages"
        tar -zxf ${COURSE_DIR}/Course_Env.tar.gz -C ${COURSE_DIR}/Course_Env
        rm -f ${COURSE_DIR}/Course_Env.tar.gz
    else
        ln -sf Course_Env ${COURSE_DIR}/Course_Env
    fi

    if [ ! -d "Data" ] 
    then 
        echo "----------> downloading data"
        mkdir -p ${COURSE_DIR}/Data
        fix-permissions ${COURSE_DIR}/Data
        wget -t 10 https://zenodo.org/record/7670839/files/Data.tar.gz?download=1 -O ${COURSE_DIR}/Data.tar.gz
        echo "----------> extracting data"
        tar -zxf ${COURSE_DIR}/Data.tar.gz -C ${COURSE_DIR}/Data
        rm -f ${COURSE_DIR}/Data.tar.gz 
    else
        ln -sf Data ${COURSE_DIR}/Data
    fi

    echo "----------> Installing course kernels on jupyterlab"
    ${COURSE_DIR}/Course_Env/bin/python -m ipykernel install --user --name="args_dashboard" --display-name "args dashboard"
    ${COURSE_DIR}/Course_Env/bin/R -e "IRkernel::installspec(user=TRUE, name = 'popgen_course', displayname = 'popgen course')"
    ${COURSE_DIR}/Course_Env/bin/python -m bash_kernel.install
    
    git clone --branch ucloud --depth 1 --branch v2023.03.01  https://github.com/kaspermunch/PopulationGenomicsCourse.git /home/${NB_USER}/course
    
    if [ ! -d "Notebooks" ] 
    then 
        mv /home/${NB_USER}/course/Notebooks ./
    else
        ln -sf Notebooks ${COURSE_DIR}/Notebooks
    fi

    # kernel configurations with updated $PATH included
    cp /home/${NB_USER}/course/uCloud/Configurations/kernelBash.json ~/.local/share/jupyter/kernels/bash/kernel.json

    printf  "\n==================  "
    printf  "\n Start JupyterLab  \n"
    printf  "==================  \n\n"
    bash -c "jupyter lab --NotebookApp.token='' "
    
fi


if [ "${COURSE}" == "IGV" ]
then
    echo "-----> Chosen tool: Interactive Genomic Browser"
    cd /usr/igv-webapp
    npx http-server --port 8787 -a 0.0.0.0 dist
fi